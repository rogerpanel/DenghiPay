# =============================================================================
# eipay.env — fill in on your PC, upload, never commit, never send in a chat.
#
# This file carries placeholders only. The real file lives at
# /root/DenghiPay/eipay.env on the server, mode 600 (docs/EIPAY_INTEGRATION.md §3).
#
# Rules for typing values:
#   KEY=value     no spaces around "=", no quotes needed, one key per line.
#   Every key below must be a NEW value: everything in the old handover .env leaked.
#
# The deploy script fills these in itself — do NOT add them:
#   APP_URL, NEXT_PUBLIC_APP_URL, SMILE_ID_CALLBACK_URL   (from the eipay address)
#   PRIVY_JWKS_URL, PRIVY_ISSUER                          (from the Privy app ID)
#   INTERNAL_API_KEY, ENCRYPTION_KEY, INJECTED_SESSION_SECRET   (random, once)
#
# Accounts: each service below should be an account owned by LLC "Expat Groupe".
# The developers either transfer their account to the Company or help create
# a new one. Both are part of the handover.
# =============================================================================


# ----------------------------------------------------------------- REQUIRED --

# PAYCREST — app.paycrest.io → sign in → Settings / API keys → "API key" (a UUID).
# Today the developers' temporary key; replace with the Company's own after KYB.
PAYCREST_SENDER_KEY=

# PRIVY (sign-in and embedded wallets) — dashboard.privy.io → the eipay app →
# Settings → Basics: "App ID" and "App secret".
# Also there: add https://eipay.62.238.23.185.sslip.io to the allowed domains.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# SUPABASE (database and KYC documents) — supabase.com/dashboard → the eipay
# project → Project Settings → API: "Project URL" and the SECRET key (sb_secret_...),
# not the publishable/anon key.
# A brand-new project needs eipay's schema first: SQL Editor → run the two files
# in supabase/migrations in date order; Storage → create bucket "kyc-documents";
# then deploy supabase/functions/reconcile-pending-orders. Transferring the
# developers' existing project to the Company avoids this.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ALCHEMY (blockchain connections) — dashboard.alchemy.com → Create app → enable
# Base, Polygon, Arbitrum, BNB Smart Chain, Starknet → copy the API key.
# It reaches the browser by design; in Alchemy, restrict it to the eipay address.
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Same Alchemy app → Starknet Mainnet → copy the full HTTPS endpoint URL.
NEXT_PUBLIC_STARKNET_RPC_URL=

# Refunds of failed guest orders go here. A wallet ADDRESS the Company controls
# (0x + 40 characters), never a private key. The deploy script refuses eipay's
# built-in default address, which belongs to nobody we can name.
NEXT_PUBLIC_GUEST_REFUND_ADDRESS=

# Gas sponsor: a NEW wallet used only for this, holding only a few dollars of gas
# (ETH on Base, POL on Polygon...). Its private key: 0x + 64 hex characters.
# Whatever this wallet holds is at risk if the server is, so keep it small.
SPONSOR_EVM_WALLET_PRIVATE_KEY=


# ------------------------------------------------ PHONE CHECK (KYC tier 1) --
# eipay sends Nigerian numbers through KudiSMS and every other country through
# Twilio. Fill in at least the one your testers' phone numbers need.

# KudiSMS — kudisms.net → Dashboard → Settings → API Keys, and the OTP template.
KUDISMS_API_KEY=
KUDISMS_APP_NAME_CODE=
KUDISMS_TEMPLATE_CODE=
KUDISMS_SENDER_ID=

# Twilio — console.twilio.com → Account Info (SID, Auth Token);
# Verify → Services → create one → its Service SID (starts VA).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=


# ------------------------------------------------- IDENTITY (KYC tier 2) --
# Smile ID — portal.usesmileid.com → Developers / API keys: Partner ID, API key.
# "0" is Smile ID's sandbox (no real ID check, right for integration testing);
# "1" is production and needs the Company's own production keys.
SMILE_IDENTITY_PARTNER_ID=
SMILE_IDENTITY_API_KEY=
SMILE_IDENTITY_SERVER=0

# Dojah (tier 3, proof of address) — app.dojah.io → Developers → Configuration.
# Optional for testing; leave blank to skip tier 3.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io
KYC_DOCUMENTS_BUCKET=kyc-documents


# --------------------------------------------- SETTINGS FOR THE TEST PHASE --
# Tanzania through Paycrest (Tigo, Airtel, Halopesa), not nTZS. This also keeps
# customers' USDC out of a Company wallet (the nTZS just-in-time conversion).
TZS_PROVIDER=paycrest
NEXT_PUBLIC_TZS_PROVIDER=paycrest
NTZS_JIT_ENABLED=false
NEXT_PUBLIC_NTZS_JIT_ENABLED=false

# Monthly limits in USD per KYC tier. Small on purpose while testing;
# production values come from counsel.
NEXT_PUBLIC_KYC_TIER_0_MONTHLY=10
NEXT_PUBLIC_KYC_TIER_1_MONTHLY=50
NEXT_PUBLIC_KYC_TIER_2_MONTHLY=100
NEXT_PUBLIC_KYC_TIER_3_MONTHLY=200

# Features not under test. Each needs its own keys and its own review.
NEXT_PUBLIC_REFERRAL_ENABLED=false
NEXT_PUBLIC_BRIDGE_ENABLED=false
NEXT_PUBLIC_TRON_ENABLED=false
NEXT_PUBLIC_ONRAMP_CHAINED_FORWARDING_ENABLED=false
NEXT_PUBLIC_KES_ONRAMP_ENABLED=false
ENABLE_WALLET_CONTEXT_SYNC=false

# Their example turns on a maintenance overlay with a February date.
NEXT_PUBLIC_MAINTENANCE_NOTICE_ENABLED=
NEXT_PUBLIC_NOTICE_BANNER_TEXT=Testing phase: invited testers only.

LOG_LEVEL=info
