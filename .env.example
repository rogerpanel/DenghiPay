# =============================================================================
# MoraPay — environment template
#
# Copy to .env and fill in. Guardrail G7: this file carries documented
# placeholders only. A real value committed here is a security incident, and
# gitleaks in pre-commit and CI exists to make that impossible.
# =============================================================================

# -----------------------------------------------------------------------------
# Guardrail gates
# -----------------------------------------------------------------------------
# G1. Live third-party funds. Defaults to false and stays false until partner
# agreements and written legal opinions exist. Flipped by a human, in
# production, once, behind the manual approval gate (BUILD_PLAN 13.5).
LIVE_FUNDS_ENABLED=false

# Which corridor authorisations we actually hold. Empty, and irrelevant, while
# live funds are off. Once they are on, a corridor may only move money if every
# authorisation it rests on is named here — so opening NG-GH for real means
# writing NG_DOMESTIC_COLLECTION,GH_PAYOUT_RAIL, which is a sentence a reviewer
# can ask for evidence of. There is no wildcard. See docs/CORRIDORS.md.
# Known names: RU_COLLECTION_PARTNER, BY_COLLECTION_PARTNER,
# NG_DOMESTIC_COLLECTION, GH_DOMESTIC_COLLECTION, NG_PAYOUT_RAIL, GH_PAYOUT_RAIL
LIVE_CORRIDOR_AUTHORISATIONS=

# Node environment: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of origins allowed to call the API.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public base URL, used to build links in outbound email.
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Datastores
# -----------------------------------------------------------------------------
# Neutral-tier database: ledger, transfers, tokenised references. No sender PII.
DATABASE_URL=postgresql://morapay:morapay@localhost:5432/morapay?schema=public
REDIS_URL=redis://localhost:6379

# Per-partition PII stores (BUILD_PLAN 12.1). Left blank in local development,
# where the partition tables live in the same instance behind separate schemas.
DATABASE_URL_RU=
DATABASE_URL_NG=
DATABASE_URL_GH=

# -----------------------------------------------------------------------------
# Secrets — every one of these is replaced from the vault in staging and production
# -----------------------------------------------------------------------------
# Access-token signing key. 32+ random bytes, base64.
JWT_ACCESS_SECRET=change-me-32-bytes-minimum-for-local-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Separate key for the admin application. Never share a session with the customer app.
ADMIN_JWT_ACCESS_SECRET=change-me-admin-key-local-only
# Key that signs quotes so a client cannot edit the recipient amount before confirming.
QUOTE_SIGNING_SECRET=change-me-quote-signing-key
# Key that seals field-level encrypted PII columns. AES-256-GCM, 32 bytes, base64.
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key
# Salt for tokenising identifiers that cross a partition boundary.
TOKENISATION_SALT=change-me-tokenisation-salt

# -----------------------------------------------------------------------------
# Provider callbacks (TECHNICAL_ARCHITECTURE §4)
# -----------------------------------------------------------------------------
# HMAC-SHA256 signing secret per provider. Headers only — never in a body.
PROVIDER_SIGNING_SECRET_PAYIN_RU_SIM=replace-in-vault
PROVIDER_SIGNING_SECRET_PAYIN_NG_SIM=replace-in-vault
PROVIDER_SIGNING_SECRET_PAYIN_GH_SIM=replace-in-vault
PROVIDER_SIGNING_SECRET_PAYOUT_NG_SIM=replace-in-vault
PROVIDER_SIGNING_SECRET_PAYOUT_GH_SIM=replace-in-vault
# Maximum clock skew accepted on a callback timestamp, in seconds.
CALLBACK_MAX_SKEW_SECONDS=300

# -----------------------------------------------------------------------------
# Real providers — all disabled until G1 is satisfied (BUILD_PLAN 6.3, 7.3)
# -----------------------------------------------------------------------------
PAYCREST_ENABLED=false
PAYCREST_BASE_URL=
PAYCREST_API_KEY=replace-in-vault

FINCRA_ENABLED=false
FINCRA_BASE_URL=
FINCRA_API_KEY=replace-in-vault

# The Russian licensed partner. Commercial blocker, not a coding task.
PAYIN_RU_PARTNER_ENABLED=false
PAYIN_RU_PARTNER_BASE_URL=
PAYIN_RU_PARTNER_API_KEY=replace-in-vault

# -----------------------------------------------------------------------------
# KYC and screening
# -----------------------------------------------------------------------------
# mock | smileid | sumsub
KYC_PROVIDER=mock
SMILEID_PARTNER_ID=
SMILEID_API_KEY=replace-in-vault
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=replace-in-vault

# mock | complyadvantage | worldcheck
SCREENING_PROVIDER=mock
SCREENING_API_KEY=replace-in-vault
# Match score at or above which a screening result blocks and routes to the queue.
SCREENING_BLOCK_THRESHOLD=85

# -----------------------------------------------------------------------------
# FX rates
# -----------------------------------------------------------------------------
# simulated | ecb | partner
RATE_SOURCE=simulated
RATE_SOURCE_URL=
# Beyond this age quoting halts rather than serving a stale rate (BUILD_PLAN 4.1).
RATE_MAX_AGE_MS=120000
QUOTE_TTL_SECONDS=90

# -----------------------------------------------------------------------------
# Email / notifications
# -----------------------------------------------------------------------------
# outbox | smtp — 'outbox' writes to the database and is what local development uses.
MAIL_TRANSPORT=outbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=replace-in-vault
MAIL_FROM=no-reply@example.invalid

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=info
METRICS_ENABLED=true
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Rate limiting (BUILD_PLAN 11.3)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
